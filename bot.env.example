# A dreamBot Builder config, run through PRISM instead of the bot kit.
#
# Generate one at https://dreambot-builder.vercel.app — choose "Event
# contracts", pick a strategy, and copy the .env block it gives you at the end.
# Save it as bot.env (gitignored) and run:
#
#   bun run svc:bot bot.env
#
# THE KEY IS NOT READ FROM HERE. The Builder's block carries a PRIVATE_KEY line
# and PRISM deliberately ignores it — a config object gets logged and serialised
# into errors, and a key must not travel with it. Put the key in .env.local as
# PRISM's own PRIVATE_KEY, in the one place that already reads it.

NETWORK=testnet
DRY_RUN=true
STRATEGY=ec-starter

TAKE_MAX_SHARES=1
TAKE_MAX_POSITION=5
TAKE_INTERVAL_MS=8000

# Blank means "whatever the venue is running".
# TAKE_ASSET=BTC
