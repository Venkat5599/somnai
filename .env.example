# ── PRISM environment ────────────────────────────────────────────────────────
# Copy to .env.local (gitignored). NEVER commit a real key.

# Network: "testnet" (Shannon, chain 50312) or "mainnet" (chain 5031)
PRISM_NETWORK=testnet

# Verified live endpoints (bot-kit packages/ec-core/src/config.ts).
# The INDEXER URL is NOT the RPC url — a common and costly mix-up.
PRISM_RPC_URL=https://api.infra.testnet.somnia.network
PRISM_WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
PRISM_INDEXER_URL=https://dev.smk.somnia.host/v1/graphql

# Venue scoping. VERIFIED 2026-08-25: active binary markets span TWO venues on
# testnet, so pinning a single id silently hides half the book. Leave unset to
# accept all venues; set to pin.
# PRISM_VENUE_ID=

# Signing key for order placement. Use a burner that holds only testnet value.
# Needs STT for gas and tUSDC for collateral.
# PRIVATE_KEY=0x...

# Split-key operation: PRIVATE_KEY is the hot operator, OWNER_ADDRESS the fund
# wallet. Orders route via placeOrderFor; the hot key can never withdraw.
# OWNER_ADDRESS=0x...

# Safety. Leave true until execution is reviewed end to end.
PRISM_DRY_RUN=true
