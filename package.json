{
  "name": "prism-terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd frontend && next dev -p 3177",
    "build": "cd frontend && next build",
    "start": "cd frontend && next start -p 3177",
    "typecheck": "tsc --noEmit && cd frontend && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "svc:executor": "bun --conditions react-server backend/executor/index.ts",
    "svc:market-data": "bun --conditions react-server backend/market-data/index.ts",
    "svc:roll": "bun --conditions react-server backend/roll/index.ts",
    "svc:bot": "bun --conditions react-server backend/bot/index.ts",
    "deploy": "bun scripts/deploy-verify.ts"
  },
  "dependencies": {
    "@designcodeio/threeui": "^1.0.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@somnia-chain/markets-sdk": "^0.28.1",
    "@tanstack/react-query": "^5.102.5",
    "@types/three": "^0.185.4",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "lightweight-charts": "^5.2.1",
    "motion": "12.23.12",
    "next": "15.5.24",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "viem": "^2.55.19",
    "wagmi": "^2.16.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.13",
    "@types/bun": "^1.4.0",
    "@types/node": "22.15.3",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "tailwindcss": "4.1.13",
    "typescript": "5.8.3",
    "vitest": "^4.1.11"
  }
